# Copy to .env and fill in. Never commit .env.

# VIRTUAL = paper trading on live Binance market data. LIVE = real orders on BINANCE_ENV.
TRADING_MODE=VIRTUAL
# prod | testnet | demo   (demo = Binance Demo Trading: real market, fake funds; testnet = testnet.binance.vision)
BINANCE_ENV=demo
# Trading with BINANCE_ENV=prod additionally requires:
# CONFIRM_LIVE_PROD=yes

# API key for the chosen BINANCE_ENV (testnet / demo / prod keys are all different).
BINANCE_API_KEY=
# Either an HMAC secret...
BINANCE_SECRET=
# ...or (recommended by Binance) an Ed25519 private key: path to the PEM file or its contents
# BINANCE_PRIVATE_KEY=/path/to/ed25519-private.pem

# Strategy: ema_pullback | vwap_reversion | squeeze_breakout | opening_range | donchian_ensemble
STRATEGY=ema_pullback
SYMBOLS=BTCUSDT,ETHUSDT
# Execution bar size (stops/targets are checked on these bars)
INTERVAL=5m
# Optional slower timeframe for entry/exit signals, e.g. 15min or 1h (empty = strategy default, none = INTERVAL)
SIGNAL_TF=

# Costs used by the paper broker (0.001 = 0.1% per side; 0.00075 with BNB fee discount)
FEE_RATE=0.001
SLIPPAGE_BPS=2

# Risk
PAPER_CASH=10000
RISK_PER_TRADE=0.005
MAX_POSITION_PCT=0.25
DAILY_LOSS_LIMIT=0.02
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=2
LOSS_STREAK_COOLDOWN=3
COOLDOWN_BARS=12
# MAX_BARS_IN_TRADE=48

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradingbot
POSTGRES_HOST=localhost
# Host port for the compose db (change if 5432 is taken); containers always use 5432 internally
POSTGRES_PORT=5432
